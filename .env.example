# ============================================================
# Paper2SVG-ultra v2.1 Environment Configuration
# Copy this file to `.env` and fill in your API credentials.
# ============================================================

# OpenAI Responses API endpoint (official OpenAI or any compatible /v1 gateway)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# Optional custom header `x-openai-actor-authorization` (leave empty for standard OpenAI API)
OPENAI_ACTOR_AUTH=

# Main reasoning / multimodal / SVG model (must support OpenAI Responses API)
MAIN_MODEL=gpt-5.4
# Reasoning effort: none | low | medium | high | xhigh
REASONING_EFFORT=high

# Stage-1 image generation model passed to the Responses `image_generation` tool
# Leave empty to use your endpoint's default image model, or specify e.g. gpt-image-1.5 / gpt-image-2
IMAGE_TOOL_MODEL=
IMAGE_QUALITY=high
IMAGE_SIZE=1536x1024

# Cut 1 (AIA Front-End): Stage-4 Aesthetic & Anti-Copy Gate max auto-revision rounds (0-3)
DRAFT_REVIEW_ROUNDS=1

# Cut 2 (AutoFigure-Edit Back-End):
#   SVG_ENGINE: autofigure (v2.1 default: 0.2s CC/SAM3 -> <AF> template -> icon swap -> post-swap polish) | legacy
#   SVG_MODE: hybrid_rich (recommended) | pure_vector
SVG_ENGINE=autofigure
SVG_MODE=hybrid_rich

# Segmentation backend: auto | sam3_local | sam3_fal | sam3_roboflow | cc_zero_gpu | vlm_zero_gpu
# `auto` automatically uses SAM3 if installed/configured, else uses 0.2s pixel-exact zero-GPU CC segmentation!
SEG_BACKEND=auto
# Matting backend: auto | rmbg2 | birefnet | floodfill
# `auto` automatically uses RMBG-2.0 / BiRefNet if installed, else falls back cleanly to zero-GPU floodfill!
MATTING_BACKEND=auto
SAM_PROMPTS=icon,portrait,diagram,chart,object
ENABLE_UPSCALE_4K=false

# Optional SAM3 cloud / HuggingFace credentials (leave empty for 100% zero-GPU mode)
# FAL_KEY=
# ROBOFLOW_API_KEY=
# HF_TOKEN=
# RMBG_MODEL_PATH=

# Privacy: disable server-side response storage (`store: false`) for unpublished manuscripts
DISABLE_RESPONSE_STORAGE=true

# Pipeline defaults
DEFAULT_DENSITY=auto
DEFAULT_CRITIC_ROUNDS=1
DEFAULT_FONT_FAMILY=Inter, Helvetica, Arial, sans-serif
DEFAULT_CANVAS_WIDTH=1600
DEFAULT_CANVAS_HEIGHT=680
DEFAULT_LANG=auto
API_MAX_RETRIES=5
SERVER_HOST=127.0.0.1
SERVER_PORT=8090
