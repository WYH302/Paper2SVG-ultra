# ============================================================
# Paper2SVG-ultra v3.0 Environment Configuration
# Copy this file to `.env` and fill in your API credentials.
# ============================================================

# OpenAI Responses API endpoint (official OpenAI or any compatible /v1 gateway)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# Optional custom header `x-openai-actor-authorization` (leave empty for standard OpenAI API)
OPENAI_ACTOR_AUTH=

# Main reasoning / multimodal / SVG model (must support OpenAI Responses API)
MAIN_MODEL=gpt-5.4
# Reasoning effort: none | low | medium | high | xhigh
REASONING_EFFORT=high

# Step-1 image generation model passed to the Responses `image_generation` tool
# Leave empty to use your endpoint's default image model, or specify e.g. gpt-image-1.5 / gpt-image-2
IMAGE_TOOL_MODEL=
IMAGE_QUALITY=high
IMAGE_SIZE=1536x1024

# Step 2 Icon Segmentation: auto | sam3_local | sam3_fal | sam3_roboflow | grounding_dino | cc_zero_gpu
# `auto` priority: SAM3 (local/fal/roboflow) -> local CUDA GroundingDINO -> zero-GPU frame-stripped CC + VLM filter
SEG_BACKEND=auto

# Step 3 Background Matting (real rectangular photos/portraits are always protected!):
#   auto | rmbg2 | birefnet | floodfill
# `auto` priority: RMBG-2.0 -> zero-token CUDA BiRefNet -> zero-GPU perimeter floodfill
MATTING_BACKEND=auto

# Optional: point to an existing local CUDA PyTorch Python executable (e.g. an RTX 3090 venv)
# so this repo's main `.venv` stays ultra-lightweight while using local GPU SAM3 / GroundingDINO / RMBG-2.0 / BiRefNet!
# GPU_PYTHON=C:\path\to\your\cuda-venv\Scripts\python.exe
# Optional HuggingFace mirror for faster downloads (e.g. https://hf-mirror.com)
# HF_ENDPOINT=

# Optional SAM3 cloud API / HuggingFace gated model credentials (leave empty for zero-token mode)
# FAL_KEY=
# ROBOFLOW_API_KEY=
# HF_TOKEN=
# RMBG_MODEL_PATH=
SAM_PROMPTS=icon,person,robot,animal,diagram,chart
ENABLE_UPSCALE_4K=false

# Step 4.6 + Step 5.5 SVG Alignment & Post-Swap Polish Rounds (default: 2 = 1 template align + 1 post-swap polish)
OPTIMIZE_ITERATIONS=2
SVG_MODE=hybrid_rich

# Privacy: disable server-side response storage (`store: false`) for unpublished manuscripts
DISABLE_RESPONSE_STORAGE=true

# Defaults
DEFAULT_FONT_FAMILY=Inter, Helvetica, Arial, sans-serif
DEFAULT_LANG=auto
API_MAX_RETRIES=5
SERVER_HOST=127.0.0.1
SERVER_PORT=8090
