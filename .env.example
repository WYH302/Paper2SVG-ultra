# ============================================================
# Paper2SVG-ultra Environment Configuration
# Copy this file to `.env` and fill in your API credentials.
# ============================================================

# OpenAI Responses API endpoint (official OpenAI or any compatible /v1 gateway)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# Optional custom header `x-openai-actor-authorization` (leave empty for standard OpenAI API)
OPENAI_ACTOR_AUTH=

# Main reasoning / multimodal / SVG model (must support OpenAI Responses API)
MAIN_MODEL=gpt-5.4
# Reasoning effort: none | low | medium | high | xhigh
REASONING_EFFORT=high

# Stage-1 image generation model passed to the Responses `image_generation` tool
# Leave empty to use your endpoint's default image model, or specify e.g. gpt-image-1.5 / gpt-image-2
IMAGE_TOOL_MODEL=
IMAGE_QUALITY=high
IMAGE_SIZE=1536x1024

# SVG reconstruction mode:
#   hybrid_rich (recommended): editable vector cards/text/arrows + lossless cropped HD visual assets
#   pure_vector: 100% pure geometric vector primitives
SVG_MODE=hybrid_rich

# Privacy: disable server-side response storage (`store: false`) for unpublished manuscripts
DISABLE_RESPONSE_STORAGE=true

# Pipeline defaults
DEFAULT_CRITIC_ROUNDS=2
DEFAULT_FONT_FAMILY=Inter, Helvetica, Arial, sans-serif
DEFAULT_CANVAS_WIDTH=1600
DEFAULT_CANVAS_HEIGHT=680
DEFAULT_LANG=auto
SERVER_HOST=127.0.0.1
SERVER_PORT=8090
